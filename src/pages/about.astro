---
import StarField from '../components/StarField.astro';
import ConstellationCanvas from '../components/ConstellationCanvas.astro';
import Nav from '../components/Nav.astro';
import '../styles/global.css';

const glance = [
  { label: 'Studying',  value: 'Physics (Astronomy), Ilia State University' },
  { label: 'Focus',     value: 'Machine learning, data analysis, simulation' },
  { label: 'Stack',     value: 'Python, FastAPI, React, Postgres, ChromaDB, OpenAI, Anthropic, Groq' },
  { label: 'SEO tools', value: 'Ahrefs, Semrush, GSC, GA4, Screaming Frog' },
  { label: 'Freelance', value: 'SEO strategy and reporting, RAG pipelines, AI automation' },
  { label: 'Based in',  value: 'Tbilisi (UTC+4)' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Marie Khubashvili: physics (astronomy) student moving into machine learning and data science." />
  <title>About | Marie Khubashvili</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <StarField />
  <ConstellationCanvas />
  <Nav />

  <main>
    <article class="about">
      <div class="intro">
      <div class="intro-text">
      <h1>Physics and astronomy student building toward ML research</h1>

      <div class="body">
        <p>
          I'm Marie, based in Tbilisi. I study physics at Ilia State University, in the Faculty of Natural Sciences and Medicine, with astronomy as my specialty. I want to end up doing machine learning research in astrophysics, so most of what I build now is practice for that: models, data analysis, and simulations.
        </p>
        <p>
          The projects on this site show it. I worked through the regression toolkit on <a href="/projects/linear-regression-stars">star data</a>, from OLS to Lasso and Elastic Net, and ran the same methods on a <a href="/projects/housing">housing price dataset</a>. I built a <a href="/projects/physics-spring">spring simulator</a> you control with your hand on a webcam.
        </p>
        <p>
          I have also spent years doing SEO for startups: keyword strategy, technical audits, internal linking, traffic recovery. That work taught me to care about the unglamorous parts: checking the output, catching the silent failure, making sure a number is actually right. It is also why I build things that run for real users, like the <a href="/projects/friend-finder">RAG chatbot</a> live on a client's site, a <a href="/projects/automated-gsc">Search Console reporting tool</a>, and a <a href="/projects/seo-audit">competitor audit</a> that crawls both sites and flags what is missing.
        </p>
      </div>
      </div>

      <figure class="portrait">
        <img src="/marie.webp" alt="Portrait of Marie Khubashvili" width="720" height="900" />
      </figure>
      </div>

      <dl class="glance" aria-label="At a glance">
        {glance.map((g) => (
          <div class="glance-row">
            <dt>{g.label}</dt>
            <dd>{g.value}</dd>
          </div>
        ))}
      </dl>

      <p class="closing">
        Want to build something together? Reach me on{' '}
        <a href="https://github.com/MariamKhubashvilii" target="_blank" rel="noopener noreferrer">GitHub</a>.
      </p>
    </article>

    <footer>
      <span class="mono">marie.dev</span>
      <a href="/">Projects</a>
    </footer>
  </main>
</body>
</html>

<style>
  main {
    position: relative;
    z-index: 2;
    padding-top: 72px;
  }

  .about {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    padding: 72px 24px 96px;
  }

  .intro {
    display: grid;
    gap: 32px;
    grid-template-columns: minmax(0, 1fr);
  }

  .portrait {
    margin: 0;
    max-width: 240px;
    order: -1;
  }

  .portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-card);
    border: 1px solid var(--border);
  }

  @media (min-width: 820px) {
    .intro {
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 56px;
      align-items: start;
    }
    .portrait {
      order: 0;
      max-width: none;
      margin-top: 8px;
    }
  }

  h1 {
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 36px;
    max-width: 16em;
  }

  .body p {
    font-size: 17px;
    line-height: 1.75;
    color: var(--text-dim);
    margin-bottom: 20px;
    max-width: 65ch;
  }

  .body a,
  .closing a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 4px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }

  .body a:hover,
  .closing a:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .glance {
    max-width: 760px;
    margin: 48px 0;
    border-top: 1px solid var(--border);
  }

  .glance-row {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }

  dt {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-faint);
    padding-top: 3px;
  }

  dd {
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-dim);
  }

  .closing {
    max-width: 760px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-dim);
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 28px 48px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: var(--text-faint);
  }

  footer a {
    color: var(--text-dim);
    transition: color 0.2s;
  }

  footer a:hover {
    color: var(--accent);
  }

  @media (max-width: 600px) {
    .about { padding-top: 48px; }
    .glance-row { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    footer { padding: 24px; }
  }
</style>
