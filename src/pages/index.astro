---
import StarField          from '../components/StarField.astro';
import ConstellationCanvas from '../components/ConstellationCanvas.astro';
import Nav                from '../components/Nav.astro';
import ProjectCard        from '../components/ProjectCard.astro';
import ProjectRow         from '../components/ProjectRow.astro';
import ProjectListItem    from '../components/ProjectListItem.astro';
import SolarSystem        from '../components/SolarSystem.astro';
import '../styles/global.css';

// Lightweight thumbnails for the homepage; full videos live on each project page.
const thumb = (file: string) => `/thumbnails/${file}`;

// Projects that are still being built. Shown as a plain list.
const inDevelopment = [
  {
    title:       'Physics Tutor',
    description: 'Research assistant over physics papers and textbooks. Upload PDFs or link arXiv articles and get citation-aware answers.',
    tags:        ['RAG', 'ChromaDB', 'ML'],
    github:      'https://github.com/MariamKhubashvilii/Physics-Chatbot',
    page:        '/projects/physics-rag',
  },
  {
    title:       'Recession Playlist',
    description: 'Correlating Spotify audio features with macroeconomic indicators to study music and economic trends.',
    tags:        ['Data Science', 'Spotify', 'FRED'],
    github:      'https://github.com/MariamKhubashvilii/music-economy',
    page:        '/projects/recession-playlist',
  },
  {
    title:       'SEO Meta Tag Token/Tone Analyzer',
    description: 'Correlates title-tag words, phrases, and tones with click-through rate using live Google Search Console data.',
    tags:        ['Python', 'SEO', 'GSC'],
    page:        '/projects/seo-meta-analyzer',
  },
  {
    title:       'SEO Audit',
    description: 'Automated competitive SEO audit: discovers competitors, crawls both sides, flags heading errors, and surfaces keyword gaps.',
    tags:        ['Python', 'FastAPI', 'Postgres'],
    page:        '/projects/seo-audit',
  },
];

// Finished projects. `featured: true` puts a project in "Selected work" (first one is shown large).
// The rest appear under "More projects", sorted by `order` (lower shows first).
// Numbers are spaced by 10 so a new project can slot in (e.g. 25 between 20 and 30).
const finished = [
  {
    order:       1,
    featured:    true,
    title:       'Orion Field',
    description: 'Free interactive physics tools you can drag and watch respond, from time dilation to orbital burns. Every number is computed live.',
    tags:        ['Physics', 'Simulation', 'Web'],
    github:      'https://github.com/MariamKhubashvilii/Orion-Field',
    image:       thumb('orion-field.jpg'),
    demo:        'https://orion-field.web.app/',
    page:        '/projects/orion-field',
  },
  {
    order:       5,
    featured:    true,
    title:       'SEO Writer',
    description: 'A multi-user content platform for researching, outlining and writing SEO articles and landing pages in a brand\'s voice.',
    tags:        ['FastAPI', 'React', 'TypeScript'],
    image:       thumb('seo-writer-app.jpg'),
    demo:        'https://mariam.renode.space/',
    page:        '/projects/seo-writer',
  },
  {
    order:       10,
    featured:    true,
    title:       'RAG Chatbot for Friends Reconnected',
    description: 'A chat widget that answers questions about finding old friends online, built for Friendsreconnected.co.uk.',
    tags:        ['RAG', 'AWS', 'FastAPI'],
    github:      'https://github.com/MariamKhubashvilii/Friends-Reconnected-Chatbot',
    image:       thumb('friend-finder.jpg'),
    demo:        'https://friendsreconnected.co.uk/chat/',
    page:        '/projects/friend-finder',
  },
  {
    order:       70,
    title:       'Physics Spring',
    description: 'Interactive spring simulator with webcam hand tracking, live physics values, and damping visualization.',
    tags:        ['Python', 'OpenCV', 'MediaPipe'],
    github:      'https://github.com/MariamKhubashvilii/Physics-Spring',
    image:       thumb('physics-spring.jpg'),
    page:        '/projects/physics-spring',
  },
  {
    order:       15,
    title:       'Galaxy Zoo: Galaxy Morphology Classifier',
    description: 'An image classifier trained on about 238,000 Galaxy Zoo 2 telescope images to sort galaxies into spiral, barred spiral, elliptical and merger.',
    tags:        ['Vertex AI', 'AutoML', 'Astronomy'],
    page:        '/projects/galaxy-zoo',
  },
  {
    order:       16,
    title:       'Gaia: Hertzsprung-Russell Diagram Clustering',
    description: 'k-means in BigQuery ML over about 24.8 million Gaia DR3 stars, recovering the structure of the Hertzsprung-Russell diagram.',
    tags:        ['BigQuery ML', 'k-means', 'Astronomy'],
    page:        '/projects/gaia-hr-diagram',
  },
  {
    order:       20,
    title:       'Automated GSC Data Overview',
    description: 'A small Python tool that pulls week-over-week Google Search Console data and delivers a readable summary via email or WhatsApp.',
    tags:        ['Python', 'GSC', 'Data'],
    github:      'https://github.com/MariamKhubashvilii/Automated-GSC-Data-Overview-Message',
    image:       thumb('automated-gsc.jpg'),
    page:        '/projects/automated-gsc',
  },
  {
    order:       30,
    title:       'Wemo Check',
    description: 'A local Streamlit app that manages your wardrobe and suggests outfits based on vibes and weather.',
    tags:        ['ML', 'Streamlit', 'Anthropic'],
    github:      'https://github.com/MariamKhubashvilii/Wemo-Check',
    image:       thumb('wemo-check.jpg'),
    demo:        'https://wemocheck.streamlit.app/',
    page:        '/projects/wemo-check',
  },
  {
    order:       50,
    title:       'OpenAI RAG',
    description: 'Retrieval-Augmented Generation chatbot using OpenAI embeddings and semantic search for intelligent document retrieval.',
    tags:        ['RAG', 'OpenAI', 'AI'],
    github:      'https://github.com/MariamKhubashvilii/openai-rag',
    image:       thumb('openai-rag.jpg'),
    page:        '/projects/openai-rag',
  },
  {
    order:       55,
    title:       'SEO Writer (Streamlit)',
    description: 'Archived Streamlit version of SEO Writer: a multi-mode article and landing page optimiser, superseded by a FastAPI and React rebuild.',
    tags:        ['NLP', 'SEO', 'Streamlit'],
    github:      'https://github.com/MariamKhubashvilii/Brand-Mirror-Upgraded',
    image:       thumb('seo-writer.jpg'),
    demo:        'https://brand-mirror-upgraded.streamlit.app/',
    page:        '/projects/seo-writer-streamlit',
  },
  {
    order:       60,
    title:       'Expression Detection',
    description: 'Real-time facial expression detection using dlib facial landmarks for emotion recognition.',
    tags:        ['Computer Vision', 'ML', 'dlib'],
    github:      'https://github.com/MariamKhubashvilii/expression-detection',
    image:       thumb('expression-detection.jpg'),
    page:        '/projects/expression-detection',
  },
  {
    order:       65,
    title:       'Housing Price Regression',
    description: 'Multiple linear regression on the Kaggle Housing dataset, from outlier removal and RFE feature selection to OLS and a VIF check.',
    tags:        ['ML', 'Linear Regression', 'Data Science'],
    github:      'https://github.com/MariamKhubashvilii/Housing-Price-Regression',
    page:        '/projects/housing',
  },
  {
    order:       80,
    title:       'Physics Motion',
    description: 'A hand-controlled physics simulator that lets you create, grab, throw, and delete objects in real time. Focuses on motion and free fall.',
    tags:        ['Python', 'Physics', 'Simulation'],
    github:      'https://github.com/MariamKhubashvilii/Physics-Motion',
    image:       thumb('physics-motion.jpg'),
    page:        '/projects/physics-motion',
  },
  {
    order:       90,
    title:       'AptRank NYC',
    description: 'Apartment ranking tool for NYC that scores units across transit, price, and neighbourhood factors.',
    tags:        ['Data', 'Python', 'Tools'],
    github:      'https://github.com/MariamKhubashvilii/Apartment-Search',
    image:       thumb('aptrank-nyc.jpg'),
    demo:        'https://apartment-search.streamlit.app/',
    page:        '/projects/aptrank-nyc',
  },
  {
    order:       100,
    title:       'Superstore Profitability Analysis',
    description: 'Exploratory data analysis and binary classification on the Sample Superstore dataset. Which products or states drive the most profit?',
    tags:        ['Data Science', 'Classification', 'EDA'],
    github:      'https://github.com/MariamKhubashvilii/Superstore-Profitability-Analysis',
    image:       thumb('superstore-profitability.jpg'),
    page:        '/projects/superstore-profitability',
  },
  {
    order:       110,
    title:       'Linear Regression Star Types',
    description: 'Linear regression on star data, covering OLS, gradient descent, SGD, Ridge, Lasso, and Elastic Net.',
    tags:        ['ML', 'Linear Regression', 'Data Science'],
    github:      'https://github.com/MariamKhubashvilii/Linear-Regression-Star-Types',
    image:       thumb('linear-regression-stars.jpg'),
    page:        '/projects/linear-regression-stars',
  },
];

const sorted = [...finished].sort((a, b) => a.order - b.order);
const featured = sorted.filter((p) => p.featured);
const more = sorted.filter((p) => !p.featured);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Marie Khubashvili: physics student specializing in astronomy, moving into data science and machine learning." />
  <title>Marie Khubashvili | Projects</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <StarField />
  <ConstellationCanvas />
  <Nav />

  <main>
    <section class="hero">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1>Marie Khubashvili</h1>
          <p class="hero-sub">
            Physics student specializing in astronomy, moving into data science and machine learning. I build models, data analyses, and simulations.
          </p>
        </div>
        <SolarSystem />
      </div>
    </section>

    <div class="content">
      <section class="block" aria-labelledby="selected-work">
        <h2 id="selected-work">Selected work</h2>
        <div class="featured">
          {featured.map((p, i) => (
            <div class:list={['featured-item', { first: i === 0 }]}>
              <ProjectCard
                title={p.title}
                description={p.description}
                tags={p.tags}
                github={p.github}
                demo={p.demo}
                image={p.image}
                page={p.page}
                large={i === 0}
              />
            </div>
          ))}
        </div>
      </section>

      <section class="block" aria-labelledby="more-projects">
        <h2 id="more-projects">More projects</h2>
        <div class="rows">
          {more.map((p) => (
            <ProjectRow
              title={p.title}
              description={p.description}
              tags={p.tags}
              github={p.github}
              demo={p.demo}
              image={p.image}
              page={p.page}
            />
          ))}
        </div>
      </section>

      <section class="block" aria-labelledby="in-development">
        <h2 id="in-development">In development</h2>
        <div class="list">
          {inDevelopment.map((p) => (
            <ProjectListItem
              title={p.title}
              description={p.description}
              tags={p.tags}
              github={p.github}
              page={p.page}
            />
          ))}
        </div>
      </section>
    </div>

    <footer>
      <span class="mono">marie.dev</span>
      <a href="https://github.com/MariamKhubashvilii" target="_blank" rel="noopener noreferrer">GitHub</a>
    </footer>
  </main>
</body>
</html>

<style>
  main {
    position: relative;
    z-index: 2;
    padding-top: 72px;
  }

  .hero {
    padding: 56px 48px 72px;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
  }

  .hero-grid {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 64px;
      align-items: center;
    }
  }

  .hero-copy {
    max-width: 560px;
  }

  h1 {
    font-size: clamp(40px, 6vw, 68px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin-bottom: 20px;
  }

  .hero-sub {
    font-size: clamp(17px, 2vw, 20px);
    line-height: 1.55;
    color: var(--text-dim);
    max-width: 30em;
  }

  .content {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 48px 96px;
  }

  .block {
    margin-bottom: 96px;
  }

  .block:last-child {
    margin-bottom: 0;
  }

  h2 {
    font-size: clamp(26px, 3.4vw, 36px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin-bottom: 32px;
  }

  /* Selected work: one large card beside two stacked cards */
  .featured {
    display: grid;
    gap: 20px;
    grid-template-columns: minmax(0, 1fr);
  }

  .featured-item {
    min-width: 0;
  }

  @media (min-width: 900px) {
    .featured {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    }
    .featured-item.first {
      grid-row: 1 / span 2;
    }
  }

  /* More projects: compact two-column grid */
  .rows {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 440px), 1fr));
  }

  /* In development: plain list in two columns */
  .list {
    display: grid;
    column-gap: 48px;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 900px) {
    .list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  footer {
    border-top: 1px solid var(--border);
    padding: 28px 48px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: var(--text-faint);
  }

  footer a {
    color: var(--text-dim);
    transition: color 0.2s;
  }

  footer a:hover {
    color: var(--accent);
  }

  @media (max-width: 700px) {
    .hero    { padding: 40px 24px 48px; }
    .content { padding: 0 24px 72px; }
    .block   { margin-bottom: 72px; }
    footer   { padding: 24px; }
  }
</style>
