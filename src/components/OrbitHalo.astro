---
// OrbitHalo.astro
// The Saturn-style orbit (tilted rings, dust, small planet) that used to appear on
// homepage cards on hover. Now it lives permanently on the project page demo card.
// Place it as a direct child of a `position: relative` box.
interface Props {
  dot?:  string; // planet / ring colour (defaults to the site accent)
  line?: string; // planet edge colour
}

const { dot = '', line = '' } = Astro.props;
---

<canvas class="orbit-halo" aria-hidden="true" data-dot={dot} data-line={line}></canvas>

<style>
  .orbit-halo {
    position: absolute;
    left: -96px;
    top: -96px;
    width: calc(100% + 192px);
    height: calc(100% + 192px);
    pointer-events: none;
    z-index: 3;
  }

  @media (max-width: 767px) {
    .orbit-halo { display: none; }
  }
</style>

<script>
  const PAD = 96; // must match the offset in the CSS above
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLCanvasElement>('.orbit-halo').forEach((canvas) => {
    const box = canvas.parentElement as HTMLElement | null;
    const ctx = canvas.getContext('2d');
    if (!box || !ctx) return;

    const accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#f0b35c';
    const glowColor = canvas.dataset.dot  || accent;
    const lineColor = canvas.dataset.line || glowColor;

    let raf: number | null = null;
    let visible = true;
    let angle = 0;
    let width = 0;
    let height = 0;

    function resize() {
      const dpr = window.devicePixelRatio || 1;
      width  = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width  = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function orbitParams() {
      const w = box!.clientWidth;
      const h = box!.clientHeight;
      const r = Math.min(w, h) * 0.22;
      return {
        cx: PAD + w - w * 0.12,
        cy: PAD + h * 0.04,
        rx: r,
        ry: r * 0.42,
        rot: 0.42,
        cardW: w,
        cardH: h,
      };
    }

    function draw() {
      const c = ctx!;
      c.clearRect(0, 0, width, height);
      const p = orbitParams();

      // Rings
      c.save();
      c.translate(p.cx, p.cy);
      c.rotate(p.rot);
      c.globalAlpha = 0.18;
      for (let i = 0; i < 4; i++) {
        const offset = (i - 1.5) * 4;
        c.beginPath();
        c.ellipse(
          0, 0,
          p.rx + offset + (Math.random() - 0.5) * 8,
          p.ry + offset * 0.28 + (Math.random() - 0.5) * 6,
          0, 0, Math.PI * 2
        );
        c.strokeStyle = glowColor;
        c.lineWidth = 2 + Math.random() * 2;
        c.stroke();
      }

      // Dust
      c.globalCompositeOperation = 'lighter';
      for (let i = 0; i < 28; i++) {
        const theta  = Math.random() * Math.PI * 2;
        const radius = p.rx + 8 + Math.random() * 18;
        const x = Math.cos(theta) * radius;
        const y = Math.sin(theta) * (p.ry + 4) + (Math.random() - 0.5) * 10;
        c.beginPath();
        c.arc(x, y, Math.random() * 1.6 + 0.5, 0, Math.PI * 2);
        c.fillStyle = glowColor;
        c.fill();
      }
      c.restore();

      // Planet position on the tilted orbit
      const cosT = Math.cos(angle);
      const sinT = Math.sin(angle);
      const px = p.cx + cosT * p.rx * Math.cos(p.rot) - sinT * p.ry * Math.sin(p.rot);
      const py = p.cy + cosT * p.rx * Math.sin(p.rot) + sinT * p.ry * Math.cos(p.rot);
      const pr = Math.max(6, Math.min(14, Math.min(p.cardW, p.cardH) * 0.04));

      const grad = c.createRadialGradient(px - pr * 0.2, py - pr * 0.2, pr * 0.1, px, py, pr);
      grad.addColorStop(0, 'rgba(255,255,255,0.9)');
      grad.addColorStop(0.25, glowColor);
      grad.addColorStop(0.75, lineColor);
      grad.addColorStop(1, 'rgba(0,0,0,0.18)');
      c.beginPath();
      c.fillStyle = grad;
      c.shadowBlur = 16;
      c.shadowColor = glowColor;
      c.arc(px, py, pr, 0, Math.PI * 2);
      c.fill();
      c.shadowBlur = 0;

      // Tiny spinning ring on the planet
      c.save();
      c.translate(px, py);
      c.rotate(angle * 3.2);
      c.strokeStyle = 'rgba(255,255,255,0.24)';
      c.lineWidth = Math.max(1, pr * 0.14);
      c.beginPath();
      c.ellipse(0, 0, pr * 0.78, pr * 0.3, 0, 0, Math.PI * 2);
      c.stroke();
      c.restore();

      // Surface specks
      for (let i = 0; i < 5; i++) {
        const loc = Math.random() * Math.PI * 2;
        const off = pr * 0.55 * Math.random();
        c.beginPath();
        c.arc(
          px + Math.cos(loc) * off * 0.7,
          py + Math.sin(loc) * off * 0.4,
          Math.random() * (pr * 0.12) + 0.8,
          0, Math.PI * 2
        );
        c.fillStyle = 'rgba(255,255,255,0.18)';
        c.fill();
      }

      // Highlight
      const hi = c.createRadialGradient(px - pr * 0.25, py - pr * 0.25, pr * 0.08, px - pr * 0.25, py - pr * 0.25, pr * 0.55);
      hi.addColorStop(0, 'rgba(255,255,255,0.7)');
      hi.addColorStop(1, 'rgba(255,255,255,0)');
      c.beginPath();
      c.fillStyle = hi;
      c.arc(px - pr * 0.22, py - pr * 0.22, pr * 0.65, 0, Math.PI * 2);
      c.fill();
    }

    function frame() {
      draw();
      angle += 0.016;
      raf = visible && !document.hidden ? requestAnimationFrame(frame) : null;
    }

    function start() {
      if (reduceMotion) { draw(); return; }
      if (raf === null) frame();
    }

    resize();
    start();

    new ResizeObserver(() => { resize(); if (reduceMotion || raf === null) draw(); }).observe(box);

    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (visible) start();
    }).observe(box);

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) start();
    });
  });
</script>
