---
// ProjectCard.astro
import { Image } from 'astro:assets';

interface Props {
  title:       string;
  description: string;
  tags:        string[];
  github?:     string;
  demo?:       string;
  hasVideo?:   boolean;
  demoImage?:  string;
  comingSoon?: boolean;
  page?:       string;
  accent:      'purple' | 'mint' | 'pink' | 'blue' | 'amber' | 'emerald';
  index:       number;
}

const { title, description, tags, github, demo, hasVideo, demoImage, comingSoon, page, accent, index } = Astro.props;

const accentMap = {
  purple: { dot: '#a78bfa', glow: 'rgba(167,139,250,0.18)', tag: 'rgba(167,139,250,0.08)', tagBorder: 'rgba(167,139,250,0.14)', tagText: '#a78bfa', line: 'rgba(167,139,250,0.5)' },
  mint:   { dot: '#6ee7b7', glow: 'rgba(110,231,183,0.15)', tag: 'rgba(110,231,183,0.06)', tagBorder: 'rgba(110,231,183,0.12)', tagText: '#06b6a4', line: 'rgba(110,231,183,0.5)' },
  pink:   { dot: '#f9a8d4', glow: 'rgba(249,168,212,0.14)', tag: 'rgba(249,168,212,0.06)', tagBorder: 'rgba(249,168,212,0.12)', tagText: '#f472b6', line: 'rgba(249,168,212,0.5)' },
  blue:   { dot: '#60a5fa', glow: 'rgba(96,165,250,0.14)',  tag: 'rgba(96,165,250,0.06)',  tagBorder: 'rgba(96,165,250,0.12)',  tagText: '#60a5fa', line: 'rgba(96,165,250,0.5)' },
  amber:  { dot: '#fbbf24', glow: 'rgba(251,191,36,0.12)',  tag: 'rgba(251,191,36,0.06)',  tagBorder: 'rgba(251,191,36,0.12)',  tagText: '#f59e0b', line: 'rgba(251,191,36,0.5)' },
  emerald:{ dot: '#34d399', glow: 'rgba(52,211,153,0.14)', tag: 'rgba(52,211,153,0.06)', tagBorder: 'rgba(52,211,153,0.12)', tagText: '#10b981', line: 'rgba(52,211,153,0.5)' },
};

const c = accentMap[accent];
---

<div class="project-card-wrapper">
  <article
    class="project-card reveal"
    data-index={index}
    data-page={page}
    role={page ? 'link' : undefined}
    tabindex={page ? 0 : undefined}
    style={`--dot: ${c.dot}; --tag-bg: ${c.tag}; --tag-border: ${c.tagBorder}; --tag-text: ${c.tagText};`}
  >
    <div class="screenshot" aria-hidden="true">
      {demoImage ? (
        <div class="thumb-wrap">
          <Image
            class="screenshot-image"
            src={demoImage}
            alt=""
            width={600}
            height={340}
            format="webp"
            quality={82}
            loading="lazy"
            decoding="async"
          />
          {hasVideo && page && (
            <a class="thumb-fs" href={page}>click for full video →</a>
          )}
        </div>
      ) : comingSoon ? (
        <div class="comingsoon-thumb">No cool demos yet</div>
      ) : (
        <div class="placeholder">Screenshot</div>
      )}
    </div>

    <div class="tags">
      {tags.map(t => <span class="tag mono">{t}</span>)}
    </div>

    <h2>{title}</h2>
    <p>{description}</p>

    <div class="links">
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="link mono">
          github →
        </a>
      )}
      {demo && (
        <a href={demo} target="_blank" rel="noopener noreferrer" class="link mono">
          live demo →
        </a>
      )}
    </div>

    {page && (
      <a class="visit mono" href={page}>visit page →</a>
    )}
  </article>
</div>

<style>
  .project-card-wrapper {
    position: relative;
    width: 100%;
  }

  .project-card {
    background: var(--bg-card);
    border: 0.5px solid var(--border);
    border-radius: 28px;
    padding: 28px;
    position: relative;
    overflow: hidden;
    cursor: default;
    height: 100%;
  }

  .project-card[data-page] {
    cursor: pointer;
  }

  .tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .tag {
    font-size: 10px;
    letter-spacing: 0.06em;
    padding: 3px 9px;
    border-radius: 10px;
    background: var(--tag-bg);
    border: 0.5px solid var(--tag-border);
    color: var(--tag-text);
  }

  .screenshot {
    width: 100%;
    aspect-ratio: 600 / 340;
    overflow: hidden;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, rgba(255,255,255,0.02), transparent);
    border-radius: 12px;
  }

  .thumb-wrap {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 12px;
    overflow: hidden;
  }

  .screenshot .placeholder {
    width: 100%;
    height: 100%;
    border-radius: 12px;
    border: 0.5px dashed rgba(255,255,255,0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(226,228,240,0.32);
    font-size: 12px;
    letter-spacing: 0.04em;
    background: rgba(255,255,255,0.01);
  }

  .screenshot-image {
    width: 100%;
    height: 100%;
    border-radius: 12px;
    object-fit: contain;
    background: rgba(255,255,255,0.02);
  }

  .comingsoon-thumb {
    width: 100%;
    height: 100%;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-align: center;
    border: 0.5px solid rgba(255,255,255,0.06);
    background-clip: padding-box;
    color: transparent;
    background-image:
      radial-gradient(ellipse at 30% 25%, rgba(167,139,250,0.16), transparent 60%),
      radial-gradient(ellipse at 75% 80%, rgba(249,168,212,0.14), transparent 60%),
      linear-gradient(120deg, var(--purple) 0%, var(--mint) 55%, var(--pink) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .thumb-fs {
    position: absolute;
    right: 8px;
    bottom: 8px;
    background: rgba(0,0,0,0.22);
    border: 1px solid rgba(255,255,255,0.05);
    padding: 6px 10px;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    color: transparent;
    background-image: linear-gradient(120deg, var(--purple) 0%, var(--mint) 55%, var(--pink) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    box-shadow: 0 6px 18px rgba(2,6,23,0.38);
  }

  h2 {
    font-size: 18px;
    font-weight: 500;
    margin-bottom: 10px;
    color: var(--text);
    letter-spacing: -0.01em;
  }

  p {
    font-size: 14px;
    color: var(--text-dim);
    line-height: 1.7;
  }

  .links {
    display: flex;
    gap: 16px;
    margin-top: 20px;
  }

  .link {
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--dot);
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .link:hover {
    opacity: 1;
  }

  .visit {
    display: inline-block;
    margin-top: 16px;
    font-size: 11px;
    letter-spacing: 0.06em;
    padding: 7px 16px;
    border-radius: 999px;
    border: 0.5px solid var(--dot);
    color: var(--dot);
    text-decoration: none;
  }

  /* Touch devices and small screens: the visit button replaces the video overlay */
  @media (max-width: 767px), (hover: none) {
    .thumb-fs {
      display: none;
    }
  }
</style>

<script>
  // Whole card links to its project page; inner links keep their own targets.
  document.querySelectorAll<HTMLElement>('.project-card[data-page]').forEach((card) => {
    const pageUrl = card.dataset.page!;

    card.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) return;
      window.location.href = pageUrl;
    });

    card.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.target !== card) return;
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        window.location.href = pageUrl;
      }
    });
  });
</script>
