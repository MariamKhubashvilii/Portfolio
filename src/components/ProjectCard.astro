---
// ProjectCard.astro: featured project card (large image on top).
interface Props {
  title:       string;
  description: string;
  tags:        readonly string[];
  github?:     string;
  demo?:       string;
  image?:      string;
  page?:       string;
  large?:      boolean;
}

const { title, description, tags, github, demo, image, page, large = false } = Astro.props;
---

<article class:list={['card', { large }]}>
  <div class="media">
    {image ? (
      <img
        src={image}
        alt={`Screenshot of ${title}`}
        width="800"
        height="500"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="media-empty">Screenshot coming soon</div>
    )}
  </div>

  <div class="body">
    <ul class="tag-list">
      {tags.map((t) => <li class="tag">{t}</li>)}
    </ul>

    <h3>{title}</h3>
    <p>{description}</p>

    <div class="links">
      {page && (
        <a class="visit stretched" href={page}>View project</a>
      )}
      {github && (
        <a class="text-link" href={github} target="_blank" rel="noopener noreferrer">GitHub</a>
      )}
      {demo && (
        <a class="text-link" href={demo} target="_blank" rel="noopener noreferrer">Live demo</a>
      )}
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    cursor: pointer;
  }

  .card:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .media {
    aspect-ratio: 16 / 9;
    background: var(--bg-raised);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .card.large .media {
    aspect-ratio: auto;
    flex: 1 1 auto;
    min-height: 280px;
  }

  .media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .media-empty {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--text-faint);
    font-size: 13px;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 22px 24px 24px;
  }

  h3 {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--text);
  }

  .card.large h3 {
    font-size: 26px;
  }

  p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-dim);
    max-width: 62ch;
  }

  .links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 6px;
  }

  .visit {
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
  }

  /* Visit link sits above the stretched overlay's own text but the overlay covers the card */
  .visit:focus-visible {
    outline-offset: 6px;
  }
</style>
