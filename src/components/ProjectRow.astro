---
// ProjectRow.astro: compact project card (small thumbnail beside the text).
interface Props {
  title:       string;
  description: string;
  tags:        readonly string[];
  github?:     string;
  demo?:       string;
  image?:      string;
  page?:       string;
}

const { title, description, tags, github, demo, image, page } = Astro.props;
---

<article class:list={['row', { 'no-thumb': !image }]}>
  {image && (
    <div class="thumb">
      <img
        src={image}
        alt={`Screenshot of ${title}`}
        width="800"
        height="500"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <div class="text">
    <h3>
      {page ? <a class="stretched" href={page}>{title}</a> : title}
    </h3>
    <p>{description}</p>

    <ul class="tag-list">
      {tags.slice(0, 3).map((t) => <li class="tag">{t}</li>)}
    </ul>

    {(github || demo) && (
      <div class="links">
        {github && <a class="text-link" href={github} target="_blank" rel="noopener noreferrer">GitHub</a>}
        {demo && <a class="text-link" href={demo} target="_blank" rel="noopener noreferrer">Live demo</a>}
      </div>
    )}
  </div>
</article>

<style>
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
    height: 100%;
    padding: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    cursor: pointer;
  }

  .row.no-thumb {
    grid-template-columns: minmax(0, 1fr);
    padding: 20px;
  }

  .row:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .thumb {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-media);
    background: var(--bg-raised);
    overflow: hidden;
  }

  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  h3 {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--text);
  }

  h3 a {
    color: inherit;
  }

  p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--text-dim);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .links {
    display: flex;
    gap: 16px;
  }

  @media (max-width: 520px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
    .thumb {
      aspect-ratio: 16 / 9;
    }
  }
</style>
