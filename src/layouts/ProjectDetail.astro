---
import Nav from '../components/Nav.astro';
import StarField from '../components/StarField.astro';
import ConstellationCanvas from '../components/ConstellationCanvas.astro';
import OrbitHalo from '../components/OrbitHalo.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  tags: string[];
  github?: string;
  /** Kept so existing pages still compile. The site now uses one accent color. */
  accent?: string;
  liveDemo?: string;
  liveDemoLabel?: string;
  demoVideo?: string;
  demoPoster?: string;
  demoImage?: string;
  /** Several screenshots shown as a carousel in the demo card. */
  demoImages?: { src: string; alt: string }[];
  comingSoon?: boolean;
  visualLabel?: string;
  visualPlaceholder?: string;
}

const {
  title,
  description,
  tags,
  github,
  liveDemo,
  liveDemoLabel = 'Live Demo',
  demoVideo,
  demoPoster,
  demoImage,
  demoImages = [],
  comingSoon = false,
  visualLabel = 'Project',
  visualPlaceholder = 'Live demo unavailable',
} = Astro.props;

const videoType = demoVideo?.toLowerCase().endsWith('.mov') ? 'video/quicktime' : 'video/mp4';
const hasCarousel = demoImages.length > 0;
const visualHeading = demoVideo ? 'Demo' : hasCarousel ? 'Screenshots' : demoImage ? 'Screenshot' : comingSoon ? 'Demo' : visualLabel;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Marie Khubashvili</title>
    <meta name="description" content={description} />
    <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <StarField />
    <ConstellationCanvas />
    <Nav />

    <main class="project-detail-page">
      <section class="project-hero">

        <div class="hero-copy">
          <a href="/" class="back-link mono">← Back to projects</a>
          <h1>{title}</h1>
          <p class="hero-sub">{description}</p>

          <div class="project-tags">
            {tags.map((tag) => <span class="pill">{tag}</span>)}
          </div>

          <div class="hero-links">
            {github && (
              <a class="hero-action" href={github} target="_blank" rel="noopener noreferrer">
                View GitHub ↗
              </a>
            )}
            {liveDemo && (
              <a class="hero-action" href={liveDemo} target="_blank" rel="noopener noreferrer">
                {liveDemoLabel} ↗
              </a>
            )}
          </div>
        </div>

        <div class="hero-visual">
          <div class="visual-card">
            <OrbitHalo />
            <div class="visual-label">{visualHeading}</div>
            {demoVideo ? (
              <div class="video-wrap">
                <video
                  class="hero-video"
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  poster={demoPoster}
                  aria-label={`Demonstration of ${title}`}
                >
                  <source src={demoVideo} type={videoType} />
                  Your browser does not support the video tag.
                </video>
                <button class="video-fs" aria-label="Enter full screen">Click here to see the video up close</button>
              </div>
            ) : hasCarousel ? (
              <div class="carousel" data-carousel role="group" aria-roledescription="carousel" aria-label={`${title} screenshots`}>
                <div class="carousel-track" tabindex="0">
                  {demoImages.map((img, i) => (
                    <figure class="slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${demoImages.length}`}>
                      <a href={img.src} target="_blank" rel="noopener noreferrer" title="Open full size">
                        <img src={img.src} alt={img.alt} loading={i === 0 ? 'eager' : 'lazy'} />
                      </a>
                    </figure>
                  ))}
                </div>
                {demoImages.length > 1 && (
                  <div class="carousel-controls">
                    <button type="button" class="car-btn" data-dir="-1" aria-label="Previous screenshot">←</button>
                    <span class="car-count" aria-live="polite"><span data-current>1</span> / {demoImages.length}</span>
                    <button type="button" class="car-btn" data-dir="1" aria-label="Next screenshot">→</button>
                  </div>
                )}
              </div>
            ) : demoImage ? (
              <div class="image-wrap">
                <img
                  class="hero-image"
                  src={demoImage}
                  alt={`Screenshot of ${title}`}
                  loading="lazy"
                />
                <button class="video-fs image-fs" aria-label="Enlarge screenshot">Click here to see the screenshot up close</button>
              </div>
            ) : comingSoon ? (
              <div class="visual-comingsoon">
                <span class="comingsoon-text">Demo coming soon</span>
              </div>
            ) : (
              <div class="visual-placeholder">{visualPlaceholder}</div>
            )}
          </div>
        </div>

      </section>

      <slot />
    </main>

    {demoImage && (
      <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged screenshot">
        <button class="lightbox-close" aria-label="Close">×</button>
        <img src={demoImage} alt={`Enlarged screenshot of ${title}`} />
      </div>
    )}
  </body>
</html>

<style>
  body {
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
  }

  .project-detail-page {
    position: relative;
    z-index: 2;
    padding: 110px 48px 80px;
    width: 100%;
    overflow-x: clip;
  }

  .project-hero {
    display: grid;
    grid-template-columns: 1.1fr 1.3fr;
    gap: 34px;
    align-items: start;
    margin-bottom: 50px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 18px;
    color: var(--text-dim);
    text-decoration: none;
    opacity: 0.85;
  }


  .project-hero h1 {
    font-size: clamp(36px, 4.6vw, 58px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 20px;
  }

  .hero-sub {
    max-width: 620px;
    color: var(--text-dim);
    font-size: 17px;
    line-height: 1.82;
    margin-bottom: 28px;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 32px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-pill);
    padding: 6px 12px;
    border: 1px solid var(--border);
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 12px;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-action {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 20px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-strong);
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.2s ease, filter 0.2s ease;
  }

  .hero-action:first-child {
    background: var(--accent);
    border-color: var(--accent);
    color: #14100a;
  }

  .hero-action:hover {
    border-color: var(--accent);
  }

  .hero-action:first-child:hover {
    filter: brightness(1.08);
  }

  .hero-visual {
    display: flex;
    align-items: start;
    justify-content: center;
    margin-top: 96px;
  }

  .visual-card {
    position: relative;
    width: 100%;
    border-radius: var(--radius-card);
    background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02));
    border: 1px solid var(--border);
    box-shadow: 0 30px 70px rgba(0,0,0,0.18);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .visual-label {
    font-size: 13px;
    color: var(--text-faint);
  }

  .video-wrap,
  .image-wrap {
    position: relative;
    display: block;
    width: 100%;
    border-radius: var(--radius-media);
    overflow: hidden;
  }

  .hero-video,
  .hero-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: contain;
    border-radius: var(--radius-media);
    background: rgba(255,255,255,0.03);
  }

  .video-fs {
    position: absolute;
    right: 12px;
    bottom: 12px;
    background: rgba(0,0,0,0.28);
    border: 1px solid rgba(255,255,255,0.06);
    padding: 8px 12px;
    border-radius: 999px;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.02em;
    cursor: pointer;
    color: var(--accent);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    opacity: 1;
    transition: opacity 0.18s ease, transform 0.12s ease;
  }

  .video-wrap:hover .video-fs,
  .image-wrap:hover .image-fs {
    opacity: 1;
    transform: translateY(-2px);
  }

  /* Screenshot carousel */
  .carousel {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    min-width: 0;
  }

  .carousel-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-radius: var(--radius-media);
    border: 1px solid var(--border);
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    margin: 0;
  }

  .slide a {
    display: block;
  }

  .slide img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: contain;
    object-position: top center;
    /* Matches the app's own light background so wide screenshots do not show a hard edge */
    background: #f6f5f1;
  }

  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }

  .car-btn {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border-strong);
    background: var(--bg-raised);
    color: var(--text);
    font-size: 16px;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.2s ease, opacity 0.2s ease;
  }

  .car-btn:hover:not(:disabled) {
    border-color: var(--accent);
  }

  .car-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .car-count {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text-dim);
    min-width: 4.5em;
    text-align: center;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    place-items: center;
    padding: 40px;
    background: rgba(2, 6, 23, 0.86);
    backdrop-filter: blur(6px);
    cursor: zoom-out;
  }

  .lightbox.open {
    display: grid;
  }

  .lightbox img {
    max-width: 95vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 16px;
    box-shadow: 0 30px 80px rgba(0,0,0,0.5);
    cursor: default;
  }

  .lightbox-close {
    position: fixed;
    top: 24px;
    right: 28px;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.16);
    background: rgba(255,255,255,0.08);
    color: var(--text);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    transition: background 0.18s ease;
  }

  .lightbox-close:hover {
    background: rgba(255,255,255,0.16);
  }

  .visual-comingsoon {
    flex: 1;
    min-height: 260px;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-media);
    border: 1px solid var(--border);
    background: var(--bg-raised);
    display: grid;
    place-items: center;
    text-align: center;
    padding: 26px;
  }

  .comingsoon-text {
    font-size: 16px;
    color: var(--text-faint);
  }


  .visual-placeholder {
    flex: 1;
    min-height: 220px;
    border-radius: 24px;
    border: 1px dashed rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.02);
    display: grid;
    place-items: center;
    color: rgba(226,228,240,0.32);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-align: center;
    padding: 26px;
  }

  :global(.project-grid) {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(320px, 1fr);
    gap: 20px;
    margin-bottom: 44px;
  }

  :global(.project-card) {
    background: var(--bg-card);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-card);
    padding: 28px;
  }

  :global(.project-card h2) {
    font-size: 18px;
    margin-bottom: 12px;
  }

  :global(.project-card p),
  :global(.project-card li) {
    color: var(--text-dim);
    line-height: 1.8;
    font-size: 14px;
  }

  :global(.summary-list) {
    display: grid;
    gap: 18px;
    margin-top: 18px;
  }

  :global(.summary-list strong),
  :global(.section-content h3),
  :global(.usage-card strong) {
    color: var(--text);
    display: block;
    margin-bottom: 4px;
  }

  :global(.detail-card ul),
  :global(.section-content ul) {
    display: grid;
    gap: 12px;
    padding-left: 18px;
    list-style-position: inside;
    margin: 0;
  }

  :global(.project-section) {
    margin-top: 24px;
    border-top: 0.5px solid rgba(255,255,255,0.06);
    padding-top: 26px;
  }

  :global(.section-content h2),
  :global(.project-usage h2) {
    margin-bottom: 12px;
  }

  :global(.section-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
    margin-top: 24px;
  }

  :global(.project-usage) {
    margin-top: 40px;
  }

  :global(.usage-card) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 20px;
    border: 0.5px solid rgba(255,255,255,0.08);
    border-radius: var(--radius-media);
    padding: 20px;
    background: rgba(255,255,255,0.02);
  }

  :global(code) {
    color: var(--text);
    background: rgba(255,255,255,0.07);
    border-radius: 6px;
    padding: 2px 6px;
    font-family: var(--mono);
    font-size: 0.92em;
  }

  @media (max-width: 920px) {
    .project-hero,
    :global(.project-grid),
    :global(.section-grid),
    :global(.usage-card) {
      grid-template-columns: 1fr;
    }

    .project-detail-page {
      padding: 100px 24px 60px;
    }

    .hero-visual {
      margin-top: 0;
    }
  }

  @media (max-width: 600px) {
    .hero-action {
      width: 100%;
      justify-content: center;
    }

    .project-detail-page {
      padding: 90px 18px 50px;
    }
  }
</style>

{hasCarousel && (
  <script>
    (function () {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      document.querySelectorAll('[data-carousel]').forEach((root) => {
        const track = root.querySelector('.carousel-track');
        const count = root.querySelectorAll('.slide').length;
        const label = root.querySelector('[data-current]');
        const buttons = root.querySelectorAll('.car-btn');
        if (!track) return;

        const index = () => Math.round(track.scrollLeft / track.clientWidth);

        function sync() {
          const i = index();
          if (label) label.textContent = String(i + 1);
          buttons.forEach((b) => {
            const dir = Number(b.getAttribute('data-dir'));
            b.disabled = (dir < 0 && i <= 0) || (dir > 0 && i >= count - 1);
          });
        }

        function go(i) {
          const next = Math.max(0, Math.min(count - 1, i));
          track.scrollTo({ left: next * track.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
        }

        buttons.forEach((b) => {
          b.addEventListener('click', () => go(index() + Number(b.getAttribute('data-dir'))));
        });

        track.addEventListener('scroll', sync, { passive: true });
        track.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight') { e.preventDefault(); go(index() + 1); }
          if (e.key === 'ArrowLeft')  { e.preventDefault(); go(index() - 1); }
        });
        window.addEventListener('resize', () => go(index()));
        sync();
      });
    })();
  </script>
)}

{(demoVideo || demoImage) && (
  <script>
    (function () {
      function goFullscreen(el) {
        if (!el) return;
        if (el.requestFullscreen) return el.requestFullscreen();
        if (el.webkitRequestFullscreen) return el.webkitRequestFullscreen();
        if (el.msRequestFullscreen) return el.msRequestFullscreen();
      }

      const lightbox = document.getElementById('lightbox');

      function closeLightbox() {
        if (lightbox) lightbox.classList.remove('open');
      }

      document.addEventListener('click', (e) => {
        const imgBtn = e.target.closest('.image-fs');
        if (imgBtn) {
          if (lightbox) lightbox.classList.add('open');
          return;
        }

        const fsBtn = e.target.closest('.video-fs');
        if (fsBtn) {
          const wrap = fsBtn.closest('.video-wrap');
          const vid = wrap && wrap.querySelector('video');
          if (vid) goFullscreen(vid);
          return;
        }

        if (lightbox && lightbox.classList.contains('open')) {
          if (e.target.closest('.lightbox-close') || !e.target.closest('img')) {
            closeLightbox();
          }
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
      });
    })();
  </script>
)}
